<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <TextView android:id="@+id/channelIndex" android:layout_width="38dp" android:layout_height="38dp"
        android:gravity="center" android:text="1" android:textColor="@color/primary" android:textStyle="bold"
        android:background="@drawable/bg_toggle_selected"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="11dp" android:orientation="vertical">
        <TextView android:id="@+id/channelName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="2"/>
        <TextView android:id="@+id/channelGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/favorite" android:layout_width="42dp" android:layout_height="42dp"
        android:gravity="center" android:text="☆" android:textColor="#E7B83B" android:textSize="27sp"
        android:clickable="true" android:focusable="true"/>
</LinearLayout>