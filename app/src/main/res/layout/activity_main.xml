<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_root" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="14dp" android:paddingBottom="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M3U VIEWER" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Importa una playlist e visualizza i canali" android:textColor="#A7ABC7" android:textSize="13sp"/>
</LinearLayout>
<Button android:id="@+id/btnOpen" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:text="APRI" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/bg_button" android:paddingStart="18dp" android:paddingEnd="18dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:padding="14dp" android:orientation="vertical">
<TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nessun file caricato" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
<TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Apri un file .m3u o .m3u8 per iniziare" android:textColor="#989DBA" android:textSize="13sp"/>
</LinearLayout>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_search" android:hint="Cerca canale, gruppo o ID…" android:textColorHint="#737895" android:textColor="#FFFFFF" android:singleLine="true" android:paddingStart="16dp" android:paddingEnd="16dp"/>
<Spinner android:id="@+id/groupSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_search" android:paddingStart="12dp" android:paddingEnd="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<TextView android:id="@+id/resultCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 risultati" android:textColor="#A7ABC7" android:textSize="13sp"/>
<TextView android:id="@+id/favoritesCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★ 0 preferiti" android:textColor="#A7ABC7" android:textSize="13sp"/>
</LinearLayout>
<ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:divider="@null" android:dividerHeight="0dp" android:clipToPadding="false" android:paddingBottom="6dp"/>
</LinearLayout>