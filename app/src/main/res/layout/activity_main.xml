<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_root" android:fillViewport="true"
    android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="14dp" android:paddingBottom="28dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="IPTV VIEWER" android:textColor="@color/ink" android:textSize="25sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Il tuo spazio IPTV, semplice e ordinato"
                android:textColor="@color/muted" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:id="@+id/headerBadge" android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="TV" android:textColor="@color/primary"
            android:textStyle="bold" android:background="@drawable/bg_toggle_selected"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:background="@drawable/bg_hero"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GESTISCI LA TUA PLAYLIST" android:textColor="#EDEEFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Importa M3U o accedi con le tue credenziali IPTV"
            android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
        <TextView android:id="@+id/heroStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Nessuna playlist collegata"
            android:textColor="#E3E5FF" android:textSize="13sp"/>
        <ProgressBar android:id="@+id/loading" android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginTop="10dp" android:visibility="gone"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" android:text="SORGENTE" android:textColor="@color/ink"
        android:textSize="14sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp">
        <TextView android:id="@+id/modeFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="FILE M3U" android:textColor="@color/primary" android:textStyle="bold"
            android:background="@drawable/bg_toggle_selected" android:clickable="true" android:focusable="true"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/modeIptv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="ACCESSO IPTV" android:textColor="@color/muted" android:textStyle="bold"
            android:background="@drawable/bg_toggle" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/filePanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlist locale"
            android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="Seleziona un file .m3u o .m3u8 dal telefono."
            android:textColor="@color/muted" android:textSize="13sp"/>
        <Button android:id="@+id/btnOpen" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp"
            android:text="Scegli file M3U" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:textStyle="bold" android:background="@drawable/bg_primary"/>
        <TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Nessun file selezionato"
            android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/iptvPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical"
        android:padding="18dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accesso IPTV"
            android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="Inserisci server e credenziali del tuo servizio. La porta è opzionale."
            android:textColor="@color/muted" android:textSize="13sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp">
            <EditText android:id="@+id/serverInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/bg_input" android:hint="Server / dominio / IP"
                android:textColor="@color/ink" android:textColorHint="#9AA3B5"
                android:singleLine="true" android:inputType="textUri"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <EditText android:id="@+id/portInput" android:layout_width="92dp" android:layout_height="match_parent"
                android:background="@drawable/bg_input" android:hint="Porta"
                android:textColor="@color/ink" android:textColorHint="#9AA3B5"
                android:singleLine="true" android:inputType="number"/>
        </LinearLayout>

        <EditText android:id="@+id/usernameInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp"
            android:background="@drawable/bg_input" android:hint="Nome utente"
            android:textColor="@color/ink" android:textColorHint="#9AA3B5"
            android:singleLine="true" android:inputType="text"/>

        <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp"
            android:background="@drawable/bg_input" android:hint="Password"
            android:textColor="@color/ink" android:textColorHint="#9AA3B5"
            android:singleLine="true" android:inputType="textPassword"/>

        <CheckBox android:id="@+id/saveCredentials" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Ricorda credenziali su questo dispositivo"
            android:textColor="@color/muted" android:textSize="12sp"/>

        <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="6dp" android:text="Connetti e carica playlist"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="@drawable/bg_primary"/>
        <TextView android:id="@+id/connectionHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:text="Esempi: http://server:8080  •  https://dominio"
            android:textColor="@color/muted" android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/credentialsSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical"
        android:padding="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="ACCESSO SALVATO" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/credentialState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PRONTO" android:textColor="@color/success" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/credentialSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I TUOI CANALI"
                android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="0 canali • 0 preferiti"
                android:textColor="@color/muted" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/resultCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>

    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_input" android:hint="Cerca canale o categoria…"
        android:textColor="@color/ink" android:textColorHint="#9AA3B5" android:singleLine="true"/>

    <Spinner android:id="@+id/groupSpinner" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="9dp" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp"/>

    <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="420dp"
        android:layout_marginTop="10dp" android:divider="@null" android:dividerHeight="0dp" android:clipToPadding="false"/>
</LinearLayout>
</ScrollView>