<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_root" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
    android:paddingTop="12dp" android:paddingBottom="28dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="IPTV VIEWER" android:textColor="@color/ink" android:textSize="27sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Il tuo centro TV, veloce e intelligente"
                android:textColor="@color/muted" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:id="@+id/headerBadge" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="TV" android:textColor="#FFFFFF" android:textSize="13sp"
            android:textStyle="bold" android:background="@drawable/bg_primary"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:background="@drawable/bg_hero" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LA TUA TV IN UN SOLO POSTO" android:textColor="#E8E9FF" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Playlist, categorie e canali sempre a portata di mano"
                    android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="46dp" android:layout_height="46dp" android:gravity="center"
                android:text="▶" android:textColor="@color/primary" android:textSize="18sp" android:background="@drawable/bg_toggle_selected"/>
        </LinearLayout>
        <TextView android:id="@+id/heroStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Nessuna playlist collegata"
            android:textColor="#E3E5FF" android:textSize="13sp"/>
        <ProgressBar android:id="@+id/loading" android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginTop="8dp" android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp"
            android:background="@drawable/bg_card">
            <TextView android:id="@+id/resultCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CANALI VISIBILI" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp"
            android:background="@drawable/bg_card">
            <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 canali" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIBRERIA IPTV" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="SORGENTE" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="9dp">
        <TextView android:id="@+id/modeFile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="FILE M3U" android:textColor="@color/primary" android:textStyle="bold"
            android:background="@drawable/bg_toggle_selected" android:clickable="true" android:focusable="true"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/modeIptv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="ACCESSO IPTV" android:textColor="@color/muted" android:textStyle="bold"
            android:background="@drawable/bg_toggle" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/filePanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="17dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlist locale"
            android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Importa un file .m3u o .m3u8 dal dispositivo."
            android:textColor="@color/muted" android:textSize="12sp"/>
        <Button android:id="@+id/btnOpen" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp"
            android:text="＋  Scegli file M3U" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:textStyle="bold" android:background="@drawable/bg_primary"/>
        <TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Nessun file selezionato" android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/iptvPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical"
        android:padding="17dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accesso Xtream"
            android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Inserisci le credenziali. Se la porta è vuota, l’app rileva automaticamente il servizio."
            android:textColor="@color/muted" android:textSize="12sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="13dp">
            <EditText android:id="@+id/serverInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/bg_input" android:hint="Server / dominio / IP" android:textColor="@color/ink"
                android:textColorHint="#9AA3B5" android:singleLine="true" android:inputType="textUri"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <EditText android:id="@+id/portInput" android:layout_width="88dp" android:layout_height="match_parent"
                android:background="@drawable/bg_input" android:hint="Porta" android:textColor="@color/ink"
                android:textColorHint="#9AA3B5" android:singleLine="true" android:inputType="number"/>
        </LinearLayout>
        <EditText android:id="@+id/usernameInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="9dp"
            android:background="@drawable/bg_input" android:hint="Nome utente" android:textColor="@color/ink"
            android:textColorHint="#9AA3B5" android:singleLine="true" android:inputType="text"/>
        <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="9dp"
            android:background="@drawable/bg_input" android:hint="Password" android:textColor="@color/ink"
            android:textColorHint="#9AA3B5" android:singleLine="true" android:inputType="textPassword"/>
        <CheckBox android:id="@+id/saveCredentials" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:text="Ricorda accesso" android:textColor="@color/muted" android:textSize="12sp"/>
        <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="5dp" android:text="Connetti e carica playlist" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_primary"/>
        <TextView android:id="@+id/connectionHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Xtream Codes • HTTP / HTTPS • rilevamento automatico"
            android:textColor="@color/muted" android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/credentialsSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical"
        android:padding="15dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="ACCESSO SALVATO" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/credentialState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PRONTO" android:textColor="@color/success" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/credentialSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>

    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp"
        android:background="@drawable/bg_input" android:hint="⌕  Cerca canale, categoria o ID…"
        android:textColor="@color/ink" android:textColorHint="#8D97AA" android:singleLine="true" android:paddingStart="16dp" android:paddingEnd="16dp"/>

    <Spinner android:id="@+id/groupSpinner" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="CANALI" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>

    <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="500dp"
        android:layout_marginTop="9dp" android:divider="@null" android:dividerHeight="0dp" android:clipToPadding="false"/>
</LinearLayout>
</ScrollView>